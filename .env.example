# Neon PostgreSQL connection string (copy from Neon Console)
DATABASE_URL="postgres://username:password@ep-your-neon-endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign JWT session tokens (generate a strong random string)
JWT_SECRET="replace-with-a-very-secure-random-secret-key-32chars"

# Port (Render sets this automatically)
PORT=3000

# Allowed CORS origins (* or your domain)
CORS_ORIGIN="*"
